# ==============================================================================
# Configuración de Entorno - Práctica Big Data (Dask) + NoSQL (MongoDB Atlas)
# Rol responsable: Arquitecto Cloud
# ==============================================================================
# Copia este archivo a .env y reemplaza los valores con tus credenciales reales.
# NUNCA subas el archivo .env al repositorio Git.

# --- MongoDB Atlas (Obligatorio para persistencia NoSQL) ---
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=BigDataLab
MONGO_DB_NAME=ecommerce_bigdata_analytics

# --- Procesamiento Paralelo con Dask ---
DASK_N_WORKERS=4
DASK_THREADS_PER_WORKER=2
DASK_MEMORY_LIMIT=1.5GB
DASK_BLOCKSIZE=64MB
# false = hilos en LocalCluster (óptimo en RAM para un nodo local); true = procesos aislados
DASK_USE_PROCESSES=false
# Opcional: especifica dirección de scheduler remoto en AWS/GCP (ej. tcp://10.0.1.15:8786)
DASK_SCHEDULER_ADDRESS=

# --- Generación de Dataset Sintético ---
# Entre 5,000,000 y 10,000,000 filas (~1GB - 2GB en CSV particionado)
DATASET_ROWS=5000000
DATASET_PARTITIONS=20

# --- Parámetros de Carga NoSQL y Red Cloud ---
MONGO_BATCH_SIZE=2000
MONGO_SAMPLE_SIZE=50000
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=30000

# --- Metadatos Cloud (AWS / GCP / Local) ---
CLOUD_PROVIDER=AWS
CLOUD_REGION=us-east-1
ENVIRONMENT=development
LOG_LEVEL=INFO
